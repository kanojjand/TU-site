---
import { getNavigation, isExternal } from '../config/navigation';
import { langFromPath, localize, useTranslations } from '../i18n';
import { getContent, url } from '../lib/content';
import Icon from './Icon.astro';
import LangSwitch from './LangSwitch.astro';

const path = Astro.url.pathname;
const lang = langFromPath(path);
const { t } = useTranslations(lang);
const { navigation, services } = getNavigation(lang);
const { site } = getContent(lang);
const home = url(localize('/', lang));
const { phone, email } = site.contacts;
const tel = phone ? `tel:${phone.replace(/[^\d+]/g, '')}` : null;
const linkAttrs = (href: string) => (isExternal(href) ? { target: '_blank', rel: 'noopener' } : {});
const isCurrentSection = (section: (typeof navigation)[number]) =>
  section.href
    ? path.startsWith(url(section.href))
    : section.groups.some((group) => group.links.some((link) => url(link.href) === path));
---

<div class="topbar">
  <div class="container topbar__row">
    <div class="topbar__contacts">
      {phone && <a href={tel}><Icon name="phone" size={16} />{phone}</a>}
      {email && <a href={`mailto:${email}`}><Icon name="mail" size={16} />{email}</a>}
    </div>
    <div class="topbar__end">
      <nav class="topbar__links" aria-label={t('header.services')}>
        {services.slice(0, 4).map((service) => <a href={service.href} {...linkAttrs(service.href)}>{service.label}</a>)}
        <a href={url(localize('/contacts/', lang))}>{t('common.contacts')}</a>
      </nav>
      <button
        class="topbar__vision"
        type="button"
        data-vision-toggle
        data-label-on={t('vision.on')}
        data-label-off={t('vision.off')}
      >
        <Icon name="eye" size={16} /><span data-vision-label>{t('vision.on')}</span>
      </button>
      <button
        class="topbar__theme"
        type="button"
        data-theme-toggle
        data-label-dark={t('theme.toDark')}
        data-label-light={t('theme.toLight')}
        aria-label={t('theme.toDark')}
        title={t('theme.toDark')}
      >
        <Icon name="moon" size={16} class="theme-icon theme-icon--moon" />
        <Icon name="sun" size={16} class="theme-icon theme-icon--sun" />
      </button>
      <LangSwitch tone="bar" />
    </div>
  </div>
</div>

<header class="header" data-header>
  <div class="container header__row">
    <a class="header__logo" href={home}>
      <img class="logo-light" src={url('/brand/logo.svg')} alt={t('site.home')} width="187" height="60" />
      <img class="logo-dark" src={url('/brand/logo-white.svg')} alt={t('site.home')} width="187" height="60" />
    </a>

    <nav class="nav" aria-label={t('header.mainMenu')}>
      <ul class="nav__list" role="list">
        {
          navigation.map((section) => (
            <li class="nav__item" data-nav-item>
              {section.groups.length ? (
                <button
                  class:list={['nav__trigger', { 'is-current': isCurrentSection(section) }]}
                  type="button"
                  aria-expanded="false"
                  aria-controls={`mega-${section.id}`}
                  data-mega-trigger
                >
                  {section.label}
                  <Icon name="chevron-down" size={16} />
                </button>
              ) : (
                <a
                  class:list={['nav__trigger', { 'is-current': isCurrentSection(section) }]}
                  href={url(section.href!)}
                  aria-current={isCurrentSection(section) ? 'page' : undefined}
                >
                  {section.label}
                </a>
              )}
              {section.groups.length > 0 && (
                <div class="mega" id={`mega-${section.id}`} hidden data-mega>
                  <div class="container mega__inner">
                    <div class="mega__intro">
                      <p class="mega__title">{section.label}</p>
                      <p class="mega__text">{section.intro}</p>
                      {section.promo && (
                        <a class="mega__promo" href={section.promo.href} {...linkAttrs(section.promo.href)}>
                          <span class="mega__promo-title">{section.promo.title}</span>
                          <span class="mega__promo-text">{section.promo.text}</span>
                          <span class="mega__promo-cta">
                            {section.promo.cta}
                            <Icon name="arrow-right" size={18} />
                          </span>
                        </a>
                      )}
                    </div>
                    <div class:list={['mega__groups', { 'mega__groups--wide': section.groups.length === 1 }]}>
                      {section.groups.map((group) => (
                        <div class="mega__group">
                          <p class="mega__group-title">{group.title}</p>
                          <ul role="list">
                            {group.links.map((link) => (
                              <li>
                                <a
                                  href={url(link.href)}
                                  {...linkAttrs(link.href)}
                                  aria-current={url(link.href) === path ? 'page' : undefined}
                                >
                                  {link.label}
                                  {isExternal(link.href) && <Icon name="external" size={14} />}
                                </a>
                              </li>
                            ))}
                          </ul>
                        </div>
                      ))}
                    </div>
                  </div>
                </div>
              )}
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="header__actions">
      <div class="header__compact">
        <LangSwitch />
      </div>
      <a class="icon-btn header__search" href={url(localize('/search/', lang))} aria-label={t('search.label')}>
        <Icon name="search" size={22} />
      </a>
      <a class="btn btn--primary btn--sm header__cta" href={url(localize('/enrolle/', lang))}>{t('header.apply')}</a>
      <button
        class="icon-btn header__burger"
        type="button"
        aria-expanded="false"
        aria-controls="drawer"
        aria-label={t('header.openMenu')}
        data-drawer-open
      >
        <Icon name="menu" size={24} />
      </button>
    </div>
  </div>
</header>

<div class="drawer" id="drawer" role="dialog" aria-modal="true" aria-label={t('header.siteMenu')} hidden data-drawer>
  <div class="drawer__head">
    <a class="header__logo" href={home}>
      <img class="logo-light" src={url('/brand/logo.svg')} alt={t('site.home')} width="156" height="50" />
      <img class="logo-dark" src={url('/brand/logo-white.svg')} alt={t('site.home')} width="156" height="50" />
    </a>
    <button class="icon-btn" type="button" aria-label={t('header.closeMenu')} data-drawer-close>
      <Icon name="close" size={24} />
    </button>
  </div>
  <div class="drawer__body">
    <form class="drawer__search" action={url(localize('/search/', lang))} method="get" role="search">
      <label class="visually-hidden" for="drawer-q">{t('search.label')}</label>
      <input id="drawer-q" name="q" type="search" placeholder={t('search.label')} autocomplete="off" />
      <button type="submit" aria-label={t('search.submit')}><Icon name="search" size={20} /></button>
    </form>
    <div class="drawer__prefs">
      <LangSwitch />
      <button
        class="icon-btn"
        type="button"
        data-theme-toggle
        data-label-dark={t('theme.toDark')}
        data-label-light={t('theme.toLight')}
        aria-label={t('theme.toDark')}
        title={t('theme.toDark')}
      >
        <Icon name="moon" size={22} class="theme-icon theme-icon--moon" />
        <Icon name="sun" size={22} class="theme-icon theme-icon--sun" />
      </button>
    </div>
    <nav aria-label={t('header.menu')}>
      {
        navigation.map((section) =>
          section.groups.length ? (
            <details class="drawer__section">
              <summary>
                {section.label}
                <Icon name="chevron-down" size={20} />
              </summary>
              {section.groups.map((group) => (
                <div class="drawer__group">
                  <p class="drawer__group-title">{group.title}</p>
                  <ul role="list">
                    {group.links.map((link) => (
                      <li>
                        <a href={url(link.href)} {...linkAttrs(link.href)}>
                          {link.label}
                          {isExternal(link.href) && <Icon name="external" size={14} />}
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              ))}
            </details>
          ) : (
            <a class="drawer__link" href={url(section.href!)}>
              {section.label}
            </a>
          ),
        )
      }
      <a class="drawer__link" href={url(localize('/contacts/', lang))}>{t('common.contacts')}</a>
    </nav>
    <div class="drawer__cta">
      <a class="btn btn--primary btn--block" href={url(localize('/enrolle/', lang))}>{t('header.apply2026')}</a>
      {services[0] && (
        <a class="btn btn--ghost btn--block" href={services[0].href} target="_blank" rel="noopener">
          {services[0].label}
        </a>
      )}
      <button
        class="btn btn--ghost btn--block"
        type="button"
        data-vision-toggle
        data-label-on={t('vision.on')}
        data-label-off={t('vision.off')}
      >
        <Icon name="eye" size={20} /><span data-vision-label>{t('vision.on')}</span>
      </button>
    </div>
    <div class="drawer__contacts">
      {phone && <a href={tel}><Icon name="phone" size={18} />{phone}</a>}
      {email && <a href={`mailto:${email}`}><Icon name="mail" size={18} />{email}</a>}
    </div>
  </div>
</div>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]')!;
  const triggers = [...document.querySelectorAll<HTMLButtonElement>('[data-mega-trigger]')];
  const canHover = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
  let hoverTimer: number | undefined;

  const panelOf = (trigger: HTMLButtonElement) => document.getElementById(trigger.getAttribute('aria-controls')!)!;

  function setOpen(trigger: HTMLButtonElement, open: boolean) {
    trigger.setAttribute('aria-expanded', String(open));
    panelOf(trigger).hidden = !open;
  }

  function closeAll(except?: HTMLButtonElement) {
    for (const trigger of triggers) if (trigger !== except) setOpen(trigger, false);
  }

  for (const trigger of triggers) {
    const item = trigger.closest<HTMLElement>('[data-nav-item]')!;
    trigger.addEventListener('click', () => {
      const open = trigger.getAttribute('aria-expanded') !== 'true';
      closeAll(trigger);
      setOpen(trigger, open);
    });
    item.addEventListener('focusout', (event) => {
      if (!item.contains(event.relatedTarget as Node)) setOpen(trigger, false);
    });
    if (canHover) {
      item.addEventListener('mouseenter', () => {
        window.clearTimeout(hoverTimer);
        hoverTimer = window.setTimeout(() => {
          closeAll(trigger);
          setOpen(trigger, true);
        }, 90);
      });
      item.addEventListener('mouseleave', () => {
        window.clearTimeout(hoverTimer);
        hoverTimer = window.setTimeout(() => setOpen(trigger, false), 180);
      });
    }
  }

  document.addEventListener('click', (event) => {
    if (!header.contains(event.target as Node)) closeAll();
  });

  const onScroll = () => header.classList.toggle('is-scrolled', window.scrollY > 40);
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  // Mobile drawer
  const drawer = document.querySelector<HTMLElement>('[data-drawer]')!;
  const openButton = document.querySelector<HTMLButtonElement>('[data-drawer-open]')!;
  const closeButton = drawer.querySelector<HTMLButtonElement>('[data-drawer-close]')!;
  const background = ['.topbar', '[data-header]', '#main', '.footer'].map((selector) => document.querySelector(selector));

  function toggleDrawer(open: boolean) {
    drawer.hidden = !open;
    openButton.setAttribute('aria-expanded', String(open));
    document.body.classList.toggle('no-scroll', open);
    for (const element of background) element?.toggleAttribute('inert', open);
    (open ? closeButton : openButton).focus();
  }

  openButton.addEventListener('click', () => toggleDrawer(true));
  closeButton.addEventListener('click', () => toggleDrawer(false));
  drawer.addEventListener('click', (event) => {
    if ((event.target as HTMLElement).closest('a')) toggleDrawer(false);
  });

  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;
    if (!drawer.hidden) {
      toggleDrawer(false);
      return;
    }
    const open = triggers.find((trigger) => trigger.getAttribute('aria-expanded') === 'true');
    if (open) {
      setOpen(open, false);
      open.focus();
    }
  });

  window.matchMedia('(min-width: 1200px)').addEventListener('change', (event) => {
    if (event.matches && !drawer.hidden) toggleDrawer(false);
  });

  // Low-vision mode: BaseLayout applies the saved choice before first paint; the buttons switch it.
  const root = document.documentElement;
  const visionToggles = [...document.querySelectorAll<HTMLButtonElement>('[data-vision-toggle]')];

  function syncVision() {
    const low = root.dataset.vision === 'low';
    for (const toggle of visionToggles) {
      const label = (low ? toggle.dataset.labelOff : toggle.dataset.labelOn) ?? '';
      toggle.querySelector('[data-vision-label]')!.textContent = label;
      toggle.title = label;
    }
  }

  for (const toggle of visionToggles) {
    toggle.addEventListener('click', () => {
      const low = root.dataset.vision !== 'low';
      if (low) root.dataset.vision = 'low';
      else delete root.dataset.vision;
      try {
        if (low) localStorage.setItem('vision', 'low');
        else localStorage.removeItem('vision');
      } catch {
        // Storage blocked (private mode): the choice lasts until the page is left.
      }
      syncVision();
    });
  }
  syncVision();

  // Theme, the same way: a saved choice wins; without one the site follows the system setting.
  const themeToggles = [...document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]')];
  const themeColor = document.querySelector<HTMLMetaElement>('meta[name="theme-color"]');
  const savedTheme = () => {
    try {
      return localStorage.getItem('theme');
    } catch {
      return null;
    }
  };

  function syncTheme() {
    const dark = root.dataset.theme === 'dark';
    for (const toggle of themeToggles) {
      const label = (dark ? toggle.dataset.labelLight : toggle.dataset.labelDark) ?? '';
      toggle.setAttribute('aria-label', label);
      toggle.title = label;
    }
    if (themeColor) themeColor.content = dark ? '#141414' : '#ffffff';
  }

  for (const toggle of themeToggles) {
    toggle.addEventListener('click', () => {
      root.dataset.theme = root.dataset.theme === 'dark' ? 'light' : 'dark';
      try {
        localStorage.setItem('theme', root.dataset.theme);
      } catch {
        // Storage blocked (private mode): the theme lasts until the page is left.
      }
      syncTheme();
    });
  }
  window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', (event) => {
    if (savedTheme()) return;
    root.dataset.theme = event.matches ? 'dark' : 'light';
    syncTheme();
  });
  syncTheme();
</script>

<style>
  .topbar {
    background: var(--night);
    color: rgb(255 255 255 / 0.78);
    font-size: 0.875rem;
  }

  .topbar__row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    min-height: 40px;
  }

  .topbar a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: inherit;
    text-decoration: none;
    transition: color 0.2s var(--ease);
  }

  .topbar a:hover {
    color: #fff;
  }

  .topbar__contacts,
  .topbar__links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
  }

  .topbar__end {
    display: flex;
    align-items: center;
    gap: 24px;
  }

  .topbar__vision {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 0;
    border: 0;
    background: none;
    color: #fff;
    font-size: inherit;
    font-weight: 700;
    white-space: nowrap;
    min-height: 32px;
    cursor: pointer;
  }

  .topbar__theme {
    display: inline-grid;
    place-items: center;
    min-width: 32px;
    min-height: 32px;
    padding: 0;
    border: 0;
    border-radius: 999px;
    background: none;
    color: #fff;
    cursor: pointer;
  }

  .topbar__theme:hover {
    background: rgb(255 255 255 / 0.08);
  }

  /* The moon switches to the dark theme, the sun back to the light one. */
  :global(.theme-icon--sun),
  :global(html[data-theme='dark'] .theme-icon--moon) {
    display: none;
  }

  :global(html[data-theme='dark'] .theme-icon--sun) {
    display: block;
  }

  .logo-dark,
  :global(html[data-theme='dark']) .logo-light {
    display: none;
  }

  :global(html[data-theme='dark']) .logo-dark {
    display: block;
  }

  /* Narrower desktops: the eye alone (its label stays for screen readers and as a tooltip)... */
  @media (max-width: 1599px) {
    :global(html:not([data-vision='low'])) .topbar__vision span {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
  }

  /* ...then no e-mail, which the footer and the contacts page still show... */
  @media (max-width: 1365px) {
    .topbar__contacts a[href^='mailto:'] {
      display: none;
    }
  }

  /* ...and no service links, which are in the menu and the footer too. */
  @media (max-width: 1199px) {
    .topbar__links {
      display: none;
    }
  }

  /* Larger text leaves no room for the service links here; they stay in the footer and the menu. */
  :global(html[data-vision='low']) .topbar__links {
    display: none;
  }

  @media (max-width: 1023px) {
    .topbar {
      display: none;
    }
  }

  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--paper) 96%, transparent);
    backdrop-filter: saturate(180%) blur(12px);
    border-bottom: 1px solid var(--line);
    transition: box-shadow 0.25s var(--ease);
  }

  .header.is-scrolled {
    box-shadow: 0 8px 24px -16px rgb(0 0 0 / 0.25);
  }

  .header__row {
    display: flex;
    align-items: center;
    gap: 24px;
    height: var(--header-h);
  }

  .header__logo {
    flex: none;
    display: block;
    border-radius: 6px;
  }

  .header__logo img {
    width: auto;
    height: 46px;
  }

  .nav {
    display: none;
    flex: 1;
    min-width: 0;
  }

  .nav__list {
    display: flex;
    justify-content: center;
    gap: 2px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav__trigger {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    height: 44px;
    padding: 0 12px;
    border: 0;
    border-radius: 999px;
    background: transparent;
    font-weight: 700;
    font-size: 1rem;
    color: var(--ink);
    text-decoration: none;
    white-space: nowrap;
    cursor: pointer;
    transition:
      background-color 0.2s var(--ease),
      color 0.2s var(--ease);
  }

  .nav__trigger:hover,
  .nav__trigger[aria-expanded='true'] {
    background: var(--mist);
  }

  .nav__trigger.is-current {
    color: var(--accent-strong);
  }

  .nav__trigger :global(.icon) {
    transition: transform 0.2s var(--ease);
  }

  .nav__trigger[aria-expanded='true'] :global(.icon) {
    transform: rotate(180deg);
  }

  .header__actions {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-left: auto;
  }

  .header__cta {
    margin-left: 6px;
  }

  /* Without the top bar (below 1024px) the language switch sits in the header itself. */
  .header__compact {
    display: flex;
    align-items: center;
  }

  @media (min-width: 1024px) {
    .header__compact {
      display: none;
    }
  }

  @media (min-width: 1200px) {
    .nav {
      display: block;
    }

    .header__actions {
      margin-left: 0;
    }

    .header__burger {
      display: none;
    }
  }

  /* Low-vision text is 25% larger, so the full menu only fits on wide screens; below that keep the drawer. */
  @media (min-width: 1200px) and (max-width: 1679px) {
    :global(html[data-vision='low']) .nav {
      display: none;
    }

    :global(html[data-vision='low']) .header__actions {
      margin-left: auto;
    }

    :global(html[data-vision='low']) .header__burger {
      display: inline-grid;
    }
  }

  @media (max-width: 599px) {
    .header__cta {
      display: none;
    }
  }

  /* Small phones: logo, languages and the menu; search and theme are at the top of the menu. */
  @media (max-width: 479px) {
    .header__search {
      display: none;
    }

    .header__logo img {
      height: 40px;
    }
  }

  /* Narrow phones (360px): a smaller logo leaves room for all three languages. */
  @media (max-width: 399px) {
    .header__logo img {
      height: 34px;
    }
  }

  /* Mega menu */
  .mega {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    background: var(--paper);
    box-shadow: 0 24px 48px -24px rgb(0 0 0 / 0.3);
    animation: mega-in 0.22s var(--ease);
  }

  .mega[hidden] {
    display: none;
  }

  @keyframes mega-in {
    from {
      opacity: 0;
      transform: translateY(-6px);
    }
  }

  .mega__inner {
    display: grid;
    grid-template-columns: 280px 1fr;
    gap: 48px;
    padding-block: 36px 40px;
  }

  .mega__title {
    font-size: var(--step-2);
    font-weight: 700;
    line-height: 1.15;
  }

  .mega__text {
    margin-top: 10px;
    color: var(--muted);
  }

  .mega__promo {
    display: grid;
    gap: 6px;
    margin-top: 24px;
    padding: 20px;
    border-radius: var(--radius);
    background: var(--red);
    color: #fff;
    text-decoration: none;
    transition: background-color 0.2s var(--ease);
  }

  .mega__promo:hover {
    background: var(--red-600);
  }

  .mega__promo-title {
    font-size: 1.25rem;
    font-weight: 700;
  }

  .mega__promo-text {
    color: rgb(255 255 255 / 0.85);
  }

  .mega__promo-cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 6px;
    font-weight: 700;
  }

  .mega__groups {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 32px;
  }

  .mega__groups--wide ul {
    columns: 3;
    column-gap: 32px;
  }

  .mega__group-title {
    margin-bottom: 12px;
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .mega__groups--wide .mega__group {
    grid-column: 1 / -1;
  }

  .mega ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .mega li {
    break-inside: avoid;
  }

  .mega li a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
