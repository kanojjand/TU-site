---
// Қаз · Рус · Eng: the same page in the other languages, or that language's home
// page when the page has no translation. Each name is written in its own language.
import { LANG_NAME, LANG_SHORT, LOCALE, langFromPath, useTranslations } from '../i18n';
import { languageLinks, sitePath, url } from '../lib/content';

interface Props {
  /** "bar": light text for the dark top bar; "plain": on the page background (mobile header, menu). */
  tone?: 'bar' | 'plain';
}

const { tone = 'plain' } = Astro.props;
const current = langFromPath(Astro.url.pathname);
const { t } = useTranslations(current);
const links = languageLinks(sitePath(Astro.url.pathname));
---

{
  links.length > 1 && (
    <nav class:list={['lang', `lang--${tone}`]} aria-label={t('header.language')}>
      {links.map((link) => (
        <a
          href={url(link.path)}
          hreflang={LOCALE[link.lang]}
          lang={LOCALE[link.lang]}
          title={LANG_NAME[link.lang]}
          aria-current={link.lang === current ? 'true' : undefined}
        >
          {LANG_SHORT[link.lang]}
        </a>
      ))}
    </nav>
  )
}

<style>
  .lang {
    display: inline-flex;
    align-items: center;
    gap: 2px;
    padding: 3px;
    border-radius: 999px;
  }

  .lang a {
    display: inline-grid;
    place-items: center;
    min-width: 40px;
    min-height: 30px;
    padding: 0 8px;
    border-radius: 999px;
    font-size: 0.8125rem;
    font-weight: 700;
    color: inherit;
    text-decoration: none;
    transition: background-color 0.2s var(--ease), color 0.2s var(--ease);
  }

  @media (max-width: 399px) {
    .lang a {
      min-width: 34px;
      padding: 0 6px;
    }
  }

  .lang--bar {
    background: rgb(255 255 255 / 0.08);
    color: rgb(255 255 255 / 0.78);
  }

  .lang--bar a:hover {
    color: #fff;
  }

  .lang--bar a[aria-current] {
    background: var(--red);
    color: #fff;
  }

  .lang--plain {
    background: var(--mist);
    color: var(--ink-2);
  }

  .lang--plain a:hover {
    color: var(--ink);
  }

  .lang--plain a[aria-current] {
    background: var(--ink);
    color: var(--paper);
  }
</style>
