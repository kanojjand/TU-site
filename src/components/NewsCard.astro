---
import { langFromPath, localize, useTranslations } from '../i18n';
import { getContent, url, type NewsItem } from '../lib/content';

interface Props {
  item: NewsItem;
  variant?: 'default' | 'featured' | 'row';
  showExcerpt?: boolean;
}

const { item, variant = 'default', showExcerpt = variant !== 'row' } = Astro.props;
const lang = langFromPath(Astro.url.pathname);
const { date } = useTranslations(lang);
const { categoryName } = getContent(lang);
---

<article class:list={['news-card', `news-card--${variant}`]}>
  <a class="news-card__link" href={url(localize(`/news/${item.id}/`, lang))}>
    <div class="news-card__media">
      {
        item.cover ? (
          <img
            src={url(item.cover.src)}
            width={item.cover.width ?? undefined}
            height={item.cover.height ?? undefined}
            alt=""
            loading="lazy"
            decoding="async"
          />
        ) : (
          <div class="news-card__placeholder">
            <img src={url('/brand/mark.svg')} alt="" width="60" height="75" loading="lazy" />
          </div>
        )
      }
    </div>
    <div class="news-card__body">
      <p class="news-card__meta">
        <span class="chip">{categoryName(item.category)}</span>
        {item.date && <time datetime={item.date}>{date(item.date)}</time>}
      </p>
      <h3 class="news-card__title">{item.title}</h3>
      {showExcerpt && item.excerpt && <p class="news-card__excerpt">{item.excerpt}</p>}
    </div>
  </a>
</article>

<style>
  .news-card {
    min-width: 0;
  }

  .news-card__link {
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--paper);
    color: inherit;
    text-decoration: none;
    transition:
      box-shadow 0.25s var(--ease),
      transform 0.25s var(--ease),
      border-color 0.25s var(--ease);
  }

  .news-card__link:hover {
    border-color: transparent;
    box-shadow: var(--shadow);
    transform: translateY(-2px);
  }

  .news-card__media {
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--mist);
  }

  .news-card__media > img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s var(--ease);
  }

  .news-card__link:hover .news-card__media > img {
    transform: scale(1.04);
  }

  .news-card__placeholder {
    display: grid;
    place-items: center;
    height: 100%;
    background: linear-gradient(135deg, var(--mist), var(--line));
  }

  .news-card__placeholder img {
    width: 56px;
    opacity: 0.5;
  }

  .news-card__body {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 20px 22px 24px;
  }

  .news-card__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 12px;
    font-size: 0.875rem;
    color: var(--muted);
  }

  .news-card__title {
    font-size: 1.1875rem;
    line-height: 1.3;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    transition: color 0.2s var(--ease);
  }

  .news-card__link:hover .news-card__title {
    color: var(--accent-strong);
  }

  .news-card__excerpt {
    color: var(--muted);
    font-size: 0.9688rem;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* Big lead story */
  @media (min-width: 720px) {
    .news-card--featured .news-card__media {
      aspect-ratio: 16 / 9;
    }

    .news-card--featured .news-card__body {
      padding: 28px 30px 32px;
    }

    .news-card--featured .news-card__title {
      font-size: var(--step-2);
    }
  }

  /* Compact horizontal row */
  .news-card--row .news-card__link {
    flex-direction: row;
    align-items: stretch;
  }

  .news-card--row .news-card__media {
    flex: none;
    width: clamp(108px, 30%, 168px);
    aspect-ratio: auto;
  }

  .news-card--row .news-card__body {
    padding: 14px 18px;
    gap: 8px;
  }

  .news-card--row .news-card__title {
    font-size: 1.0625rem;
  }
</style>
