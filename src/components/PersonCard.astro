---
import { url, withBase, type Contact, type Img } from '../lib/content';
import Icon from './Icon.astro';

interface Props {
  name: string;
  role?: string;
  photo?: Img | null;
  /** Short HTML description (degree, title). */
  summary?: string;
  contacts?: Contact[];
  href?: string | null;
  layout?: 'card' | 'wide';
}

const { name, role, photo, summary, contacts = [], href, layout = 'card' } = Astro.props;
const initials = name
  .split(/\s+/)
  .slice(0, 2)
  .map((part) => part[0])
  .join('');
const iconFor = (contact: Contact) => (contact.href?.startsWith('mailto:') ? 'mail' : contact.href?.startsWith('tel:') ? 'phone' : 'link');
---

<article class:list={['person', `person--${layout}`]}>
  <div class="person__photo">
    {
      photo ? (
        <img
          src={url(photo.src)}
          width={photo.width ?? undefined}
          height={photo.height ?? undefined}
          alt={name}
          loading="lazy"
          decoding="async"
        />
      ) : (
        <span class="person__initials" aria-hidden="true">{initials}</span>
      )
    }
  </div>
  <div class="person__body">
    {role && <p class="person__role">{role}</p>}
    <h3 class="person__name">{href ? <a href={url(href)}>{name}</a> : name}</h3>
    {summary && <div class="person__summary" set:html={withBase(summary)} />}
    {
      contacts.length > 0 && (
        <ul class="person__contacts" role="list">
          {contacts.map((contact) => (
            <li>
              <Icon name={iconFor(contact)} size={16} />
              {contact.href ? <a href={contact.href}>{contact.value}</a> : <span>{contact.value}</span>}
            </li>
          ))}
        </ul>
      )
    }
    {
      href && (
        <a class="link-arrow person__more" href={url(href)} aria-hidden="true" tabindex="-1">
          Подробнее <Icon name="arrow-right" size={18} />
        </a>
      )
    }
  </div>
</article>

<style>
  .person {
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--paper);
  }

  .person__photo {
    aspect-ratio: 4 / 4.4;
    overflow: hidden;
    background: linear-gradient(160deg, var(--mist), #e9e9e9);
  }

  .person__photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 20%;
  }

  .person__initials {
    display: grid;
    place-items: center;
    height: 100%;
    font-size: 3rem;
    font-weight: 700;
    color: var(--line-2);
  }

  .person__body {
    display: flex;
    flex-direction: column;
    gap: 8px;
    flex: 1;
    padding: 20px 22px 24px;
  }

  .person__role {
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--red-600);
  }

  .person__name {
    font-size: 1.25rem;
    line-height: 1.25;
  }

  .person__name a {
    text-decoration: none;
  }

  .person__name a:hover {
    color: var(--red-600);
  }

  .person__summary {
    font-size: 0.9688rem;
    color: var(--muted);
  }

  .person__summary :global(p + p) {
    margin-top: 6px;
  }

  .person__contacts {
    display: grid;
    gap: 6px;
    margin: 4px 0 0;
    padding: 0;
    list-style: none;
    font-size: 0.9375rem;
  }

  .person__contacts li {
    display: flex;
    align-items: center;
    gap: 8px;
    min-width: 0;
    color: var(--ink-2);
  }

  .person__contacts :global(.icon) {
    flex: none;
    color: var(--red);
  }

  .person__contacts a {
    overflow-wrap: anywhere;
    text-decoration: none;
  }

  .person__contacts a:hover {
    color: var(--red-600);
    text-decoration: underline;
  }

  .person__more {
    margin-top: auto;
    padding-top: 8px;
  }

  @media (min-width: 640px) {
    .person--wide {
      flex-direction: row;
    }

    .person--wide .person__photo {
      flex: none;
      width: 220px;
      aspect-ratio: auto;
      min-height: 260px;
    }

    .person--wide .person__body {
      padding: 28px;
    }
  }
</style>
