---
// Link back to the page the content was migrated from, so editors can compare.
import { langFromPath, useTranslations } from '../i18n';
import Icon from './Icon.astro';

interface Props {
  href: string;
}

const { href } = Astro.props;
const { t } = useTranslations(langFromPath(Astro.url.pathname));
---

<p class="source-note">
  <Icon name="link" size={16} />
  {t('common.source')} <a href={href} target="_blank" rel="noopener">{href.replace(/^https?:\/\//, '')}</a>
</p>

<style>
  .source-note {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 48px;
    padding-top: 20px;
    border-top: 1px solid var(--line);
    font-size: 0.875rem;
    color: var(--muted);
    overflow-wrap: anywhere;
  }

  .source-note a {
    color: inherit;
  }

  .source-note :global(.icon) {
    flex: none;
  }
</style>
