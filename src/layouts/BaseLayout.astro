---
import '@fontsource/pt-sans/400.css';
import '@fontsource/pt-sans/400-italic.css';
import '@fontsource/pt-sans/700.css';
import '../styles/global.css';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { url } from '../lib/content';

interface Props {
  title: string;
  description?: string;
  image?: string | null;
  /** Index the page in the site search (listings and service pages opt out). */
  searchable?: boolean;
  /** Extra structured data for search engines. */
  jsonLd?: Record<string, unknown> | null;
}

const { title, description = '', image = null, searchable = true, jsonLd = null } = Astro.props;
const SITE_NAME = 'Университет имени Ж. А. Ташенева';
const fullTitle = title === SITE_NAME ? title : `${title} — ${SITE_NAME}`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(url(image ?? '/brand/og.png'), Astro.site).href;
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      // Low-vision mode chosen in the header; applied before first paint so the page does not jump.
      try {
        if (localStorage.getItem('vision') === 'low') document.documentElement.dataset.vision = 'low';
      } catch {}
    </script>
    <title>{fullTitle}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={url('/apple-touch-icon.png')} />
    <meta name="theme-color" content="#ffffff" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <a class="skip-link" href="#main">Перейти к содержанию</a>
    <Header />
    <main id="main" tabindex="-1" data-pagefind-body={searchable ? '' : undefined}>
      <slot />
    </main>
    <Footer />
  </body>
</html>
