---
import Icon from '../../../components/Icon.astro';
import PageHero from '../../../components/PageHero.astro';
import PersonCard from '../../../components/PersonCard.astro';
import SourceNote from '../../../components/SourceNote.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { langParam, localize, useTranslations, type Lang } from '../../../i18n';
import { availableLangs, getContent, summarize, url, withBase, type Faculty } from '../../../lib/content';

export function getStaticPaths() {
  return availableLangs.flatMap((lang) =>
    getContent(lang).faculties.map((faculty) => ({
      params: { lang: langParam(lang), id: String(faculty.id) },
      props: { lang, faculty },
    })),
  );
}

const { lang, faculty } = Astro.props as { lang: Lang; faculty: Faculty };
const { t } = useTranslations(lang);
const title = faculty.title || faculty.name;
---

<BaseLayout title={title} description={summarize(faculty.html)} image={faculty.hero?.src}>
  <PageHero
    title={title}
    eyebrow={t('faculties.title')}
    image={faculty.hero}
    crumbs={[{ label: t('faculties.title'), href: '/faculties/' }, { label: faculty.name }]}
  />
  <div class="container page-body has-aside">
    <article>
      {faculty.html && <div class="prose" set:html={withBase(faculty.html)} />}

      {
        faculty.departments.length > 0 && (
          <section class="deps" aria-labelledby="deps-title">
            <h2 id="deps-title">{t('departments.title')}</h2>
            <ul class="deps__list" role="list">
              {faculty.departments.map((department) => (
                <li>
                  <a href={url(localize(`/departments/${department.id}/`, lang))}>
                    <span>{department.name}</span>
                    <Icon name="arrow-right" size={20} />
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )
      }
      <SourceNote href={faculty.source} />
    </article>

    {
      faculty.head && (
        <aside>
          <PersonCard
            name={faculty.head.name}
            role={faculty.head.role}
            photo={faculty.head.photo}
            summary={faculty.head.bio}
            contacts={faculty.head.contacts}
          />
        </aside>
      )
    }
  </div>
</BaseLayout>

<style>
  .deps {
    margin-top: clamp(40px, 5vw, 56px);
  }

  .deps h2 {
    margin-bottom: 18px;
    font-size: var(--step-2);
  }

  .deps__list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr));
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .deps__list a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    height: 100%;
    padding: 18px 20px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    font-weight: 700;
    color: var(--ink);
    text-decoration: none;
    transition: border-color 0.2s var(--ease);
  }

  .deps__list a:hover {
    border-color: var(--ink);
  }

  .deps__list :global(.icon) {
    flex: none;
    color: var(--accent);
  }
</style>
