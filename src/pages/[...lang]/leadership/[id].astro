---
import Icon from '../../../components/Icon.astro';
import PageHero from '../../../components/PageHero.astro';
import SourceNote from '../../../components/SourceNote.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { langParam, useTranslations, type Lang } from '../../../i18n';
import { availableLangs, getContent, summarize, url, withBase, type Person } from '../../../lib/content';

export function getStaticPaths() {
  return availableLangs.flatMap((lang) =>
    getContent(lang).people.map((person) => ({
      params: { lang: langParam(lang), id: String(person.id) },
      props: { lang, person },
    })),
  );
}

const { lang, person } = Astro.props as { lang: Lang; person: Person };
const { t } = useTranslations(lang);
const { leadership } = getContent(lang);
const card = leadership.groups.flatMap((group) => group.people).find((leader) => leader.id === person.id);
const name = person.name || card?.name || t('leadership.title');
const photo = person.photo ?? card?.photo ?? null;
---

<BaseLayout title={name} description={summarize(person.html)} image={photo?.src}>
  <PageHero
    title={name}
    eyebrow={card?.position || t('leadership.title')}
    crumbs={[{ label: t('leadership.title'), href: '/leadership/' }, { label: name }]}
  />
  <div class="container page-body profile">
    <aside class="profile__card">
      {photo && <img src={url(photo.src)} width={photo.width ?? undefined} height={photo.height ?? undefined} alt={name} />}
      {card?.summary && <div class="profile__summary" set:html={withBase(card.summary)} />}
      {
        card?.email && (
          <a class="profile__mail" href={`mailto:${card.email}`}>
            <Icon name="mail" size={18} />
            {card.email}
          </a>
        )
      }
    </aside>
    <article>
      <div class="prose" set:html={withBase(person.html)} />
      <SourceNote href={person.source} />
    </article>
  </div>
</BaseLayout>

<style>
  .profile {
    align-items: start;
  }

  @media (min-width: 900px) {
    .profile {
      grid-template-columns: 320px minmax(0, 1fr);
    }

    .profile__card {
      position: sticky;
      top: calc(var(--header-h) + 24px);
    }
  }

  .profile__card {
    display: grid;
    gap: 14px;
  }

  .profile__card img {
    width: 100%;
    max-width: 320px;
    aspect-ratio: 4 / 4.6;
    object-fit: cover;
    object-position: center 20%;
    border-radius: var(--radius-lg);
  }

  .profile__summary {
    color: var(--ink-2);
  }

  .profile__mail {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--accent-strong);
    font-weight: 700;
    text-decoration: none;
    overflow-wrap: anywhere;
  }

  .profile__mail:hover {
    text-decoration: underline;
  }
</style>
