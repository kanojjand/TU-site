---
// Full-text search over every page and news item, powered by Pagefind.
// The index is generated after `astro build` (see the "build" script).
import PageHero from '../../components/PageHero.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { langParam, useTranslations, type Lang } from '../../i18n';
import { availableLangs, url } from '../../lib/content';

export function getStaticPaths() {
  return availableLangs.map((lang) => ({ params: { lang: langParam(lang) }, props: { lang } }));
}

const { lang } = Astro.props as { lang: Lang };
const { t } = useTranslations(lang);
const base = import.meta.env.BASE_URL;
// Pagefind's interface speaks Russian and English itself; Kazakh is given here.
const translations =
  lang === 'kz'
    ? {
        placeholder: 'Сайт бойынша іздеу',
        clear_search: 'Тазалау',
        load_more: 'Тағы көрсету',
        search_label: 'Осы сайттан іздеу',
        filters_label: 'Сүзгілер',
        zero_results: '[SEARCH_TERM] бойынша ештеңе табылмады',
        many_results: '[SEARCH_TERM] бойынша [COUNT] нәтиже',
        one_result: '[SEARCH_TERM] бойынша [COUNT] нәтиже',
        alt_search: '[SEARCH_TERM] бойынша ештеңе табылмады. [DIFFERENT_TERM] бойынша нәтижелер көрсетілді',
        search_suggestion: '[SEARCH_TERM] бойынша ештеңе табылмады. Басқа сөзбен іздеп көріңіз:',
        searching: '[SEARCH_TERM] ізделуде...',
      }
    : null;
---

<BaseLayout title={t('search.label')} description={t('search.description')} searchable={false}>
  <link rel="stylesheet" href={url('/pagefind/pagefind-ui.css')} />
  <PageHero title={t('search.label')} crumbs={[{ label: t('search.crumb') }]} />
  <div class="container search">
    <div id="search" data-base={base} data-translations={translations ? JSON.stringify(translations) : undefined}></div>
    <p class="search__fallback" hidden data-search-fallback>{t('search.fallback')}</p>
  </div>
  <script is:inline src={url('/pagefind/pagefind-ui.js')}></script>
  <script is:inline>
    (function () {
      var root = document.getElementById('search');
      if (typeof PagefindUI === 'undefined') {
        document.querySelector('[data-search-fallback]').hidden = false;
        return;
      }
      var ui = new PagefindUI({
        element: '#search',
        baseUrl: root.dataset.base,
        showSubResults: true,
        showImages: false,
        resetStyles: false,
        autofocus: true,
        translations: root.dataset.translations ? JSON.parse(root.dataset.translations) : undefined,
      });
      var query = new URLSearchParams(location.search).get('q');
      if (query) ui.triggerSearch(query);
    })();
  </script>
</BaseLayout>

<style>
  .search {
    max-width: 880px;
    padding-block: 40px clamp(56px, 7vw, 96px);
    min-height: 40vh;
  }

  .search__fallback {
    padding: 20px;
    border-radius: var(--radius);
    background: var(--mist);
    color: var(--muted);
  }

  .search :global(.pagefind-ui) {
    --pagefind-ui-scale: 1;
    --pagefind-ui-primary: var(--accent);
    --pagefind-ui-text: var(--ink);
    --pagefind-ui-background: var(--paper);
    --pagefind-ui-border: var(--line-2);
    --pagefind-ui-tag: var(--mist);
    --pagefind-ui-border-width: 1px;
    --pagefind-ui-border-radius: 14px;
    --pagefind-ui-font: var(--font);
  }

  .search :global(.pagefind-ui__search-input) {
    font-weight: 400;
  }

  .search :global(.pagefind-ui__result-link) {
    color: var(--ink);
  }

  .search :global(.pagefind-ui__result-link:hover) {
    color: var(--accent-strong);
  }

  .search :global(mark) {
    background: var(--red-50);
    color: var(--accent-deep);
  }
</style>
