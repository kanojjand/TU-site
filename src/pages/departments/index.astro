---
import Icon from '../../components/Icon.astro';
import PageHero from '../../components/PageHero.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { departments, faculties, url } from '../../lib/content';

const groups = [
  ...faculties.map((faculty) => ({
    title: faculty.name,
    href: `/faculties/${faculty.id}/`,
    items: departments.filter((department) => department.facultyId === faculty.id),
  })),
  { title: 'Другие кафедры и центры', href: null, items: departments.filter((department) => department.facultyId === null) },
].filter((group) => group.items.length > 0);
---

<BaseLayout title="Кафедры" description="Все кафедры Университета имени Ж. А. Ташенева по институтам и факультетам.">
  <PageHero
    title="Кафедры"
    description="Кафедры сгруппированы по институтам и факультетам. Внутри — миссия, программы, преподаватели и контакты."
    eyebrow="Обучение"
    crumbs={[{ label: 'Институты и факультеты', href: '/faculties/' }, { label: 'Кафедры' }]}
  />
  <div class="container departments">
    {
      groups.map((group) => (
        <section class="group">
          <h2>{group.href ? <a href={url(group.href)}>{group.title}</a> : group.title}</h2>
          <ul class="group__list" role="list">
            {group.items.map((department) => (
              <li>
                <a href={url(`/departments/${department.id}/`)}>
                  <span>
                    <strong>{department.name}</strong>
                    {department.head && <small>{department.head.name}</small>}
                  </span>
                  <Icon name="arrow-right" size={20} />
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>
</BaseLayout>

<style>
  .departments {
    display: grid;
    gap: clamp(36px, 5vw, 56px);
    padding-block: clamp(40px, 5vw, 64px) clamp(56px, 7vw, 96px);
  }

  .group h2 {
    margin-bottom: 16px;
    font-size: var(--step-2);
  }

  .group h2 a {
    text-decoration: none;
  }

  .group h2 a:hover {
    color: var(--red-600);
  }

  .group__list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr));
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .group__list a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    height: 100%;
    padding: 18px 20px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    color: var(--ink);
    text-decoration: none;
    transition:
      border-color 0.2s var(--ease),
      box-shadow 0.2s var(--ease);
  }

  .group__list a:hover {
    border-color: transparent;
    box-shadow: var(--shadow);
  }

  .group__list span {
    display: grid;
    gap: 4px;
  }

  .group__list small {
    font-size: 0.9063rem;
    color: var(--muted);
  }

  .group__list :global(.icon) {
    flex: none;
    color: var(--red);
  }
</style>
