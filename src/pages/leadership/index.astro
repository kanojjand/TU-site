---
import PageHero from '../../components/PageHero.astro';
import PersonCard from '../../components/PersonCard.astro';
import SectionNav from '../../components/SectionNav.astro';
import SourceNote from '../../components/SourceNote.astro';
import { sectionFor } from '../../config/navigation';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { leadership, pageBySlug, people, withBase } from '../../lib/content';

const page = pageBySlug.get('leadership');
const section = sectionFor('/leadership/');
const withProfile = new Set(people.map((person) => person.id));
---

<BaseLayout title={page?.title || 'Руководство'} description="Председатель правления, ректор и проректоры Университета имени Ж. А. Ташенева.">
  <PageHero
    title={page?.title || 'Наше руководство'}
    description={page?.description}
    image={page?.hero}
    crumbs={[{ label: 'Университет' }, { label: 'Руководство' }]}
  />
  <div class:list={['container page-body', { 'has-aside': section }]}>
    <div>
      {
        leadership.groups.length ? (
          leadership.groups.map((group) => (
            <section class="group">
              {group.title && <h2>{group.title}</h2>}
              <div class="grid grid--3">
                {group.people.map((person) => (
                  <PersonCard
                    name={person.name}
                    role={group.title}
                    photo={person.photo}
                    summary={person.summary}
                    contacts={person.email ? [{ label: 'E-mail', value: person.email, href: `mailto:${person.email}` }] : []}
                    href={person.id && withProfile.has(person.id) ? `/leadership/${person.id}/` : null}
                  />
                ))}
              </div>
            </section>
          ))
        ) : (
          page?.html && <div class="prose" set:html={withBase(page.html)} />
        )
      }
      {page && <SourceNote href={page.source} />}
    </div>
    {section && <SectionNav section={section} />}
  </div>
</BaseLayout>

<style>
  .group + .group {
    margin-top: clamp(40px, 5vw, 56px);
  }

  .group h2 {
    margin-bottom: 20px;
    font-size: var(--step-2);
  }
</style>
