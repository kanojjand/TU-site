---
// News listings: /news/, /news/page/2/, /news/category/<slug>/, /news/category/<slug>/page/2/
import NewsCard from '../../components/NewsCard.astro';
import PageHero from '../../components/PageHero.astro';
import Pagination from '../../components/Pagination.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { categories, news, plural, url, type Category, type NewsItem } from '../../lib/content';

export function getStaticPaths() {
  // getStaticPaths runs in isolation, so its constants must live inside it.
  const PER_PAGE = 24;
  const paths: { params: { path: string | undefined }; props: Record<string, unknown> }[] = [];
  const add = (items: NewsItem[], prefix: string, category: Category | null) => {
    const total = Math.max(1, Math.ceil(items.length / PER_PAGE));
    for (let page = 1; page <= total; page++) {
      const path = [prefix, page > 1 ? `page/${page}` : ''].filter(Boolean).join('/');
      paths.push({
        params: { path: path || undefined },
        props: { items: items.slice((page - 1) * PER_PAGE, page * PER_PAGE), page, total, category, count: items.length },
      });
    }
  };
  add(news, '', null);
  for (const category of categories) {
    const items = news.filter((item) => item.category === category.slug);
    if (items.length) add(items, `category/${category.slug}`, category);
  }
  return paths;
}

interface Props {
  items: NewsItem[];
  page: number;
  total: number;
  category: Category | null;
  count: number;
}

const { items, page, total, category, count } = Astro.props;
const base = category ? `/news/category/${category.slug}/` : '/news/';
const counts = new Map(categories.map((c) => [c.slug, news.filter((item) => item.category === c.slug).length]));
const title = category ? category.name : 'Новости и медиа';
const pageSuffix = page > 1 ? ` — страница ${page}` : '';
---

<BaseLayout
  title={`${title}${pageSuffix}`}
  description={category ? `${category.name} Университета имени Ж. А. Ташенева.` : 'Новости, объявления, фото и видео Университета имени Ж. А. Ташенева.'}
  searchable={false}
>
  <PageHero
    title={title}
    eyebrow="Медиатека"
    crumbs={category ? [{ label: 'Новости', href: '/news/' }, { label: category.name }] : [{ label: 'Новости' }]}
  >
    <p class="news-count">{plural(count, ['материал', 'материала', 'материалов'])}</p>
  </PageHero>

  <div class="container news-page">
    <nav class="filters" aria-label="Рубрики">
      <a href={url('/news/')} aria-current={!category ? 'page' : undefined}>Все <span>{news.length}</span></a>
      {
        categories
          .filter((c) => counts.get(c.slug))
          .map((c) => (
            <a href={url(`/news/category/${c.slug}/`)} aria-current={category?.slug === c.slug ? 'page' : undefined}>
              {c.name} <span>{counts.get(c.slug)}</span>
            </a>
          ))
      }
    </nav>

    <div class="grid grid--3">
      {items.map((item) => <NewsCard item={item} />)}
    </div>

    <Pagination page={page} total={total} base={base} />
  </div>
</BaseLayout>

<style>
  .news-count {
    margin-top: 12px;
    color: var(--muted);
  }

  .news-page {
    padding-block: 32px clamp(56px, 7vw, 96px);
  }

  .filters {
    display: flex;
    gap: 8px;
    margin: 0 calc(-1 * var(--gutter)) 32px;
    padding: 4px var(--gutter) 8px;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .filters::-webkit-scrollbar {
    display: none;
  }

  .filters a {
    flex: none;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 42px;
    padding-inline: 16px;
    border: 1px solid var(--line-2);
    border-radius: 999px;
    font-weight: 700;
    font-size: 0.9375rem;
    color: var(--ink-2);
    text-decoration: none;
    transition:
      border-color 0.2s var(--ease),
      background-color 0.2s var(--ease);
  }

  .filters a:hover {
    border-color: var(--ink);
  }

  .filters a span {
    font-weight: 400;
    color: var(--muted);
  }

  .filters a[aria-current='page'] {
    border-color: var(--ink);
    background: var(--ink);
    color: #fff;
  }

  .filters a[aria-current='page'] span {
    color: rgb(255 255 255 / 0.7);
  }
</style>
